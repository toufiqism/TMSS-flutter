<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The main manifest sets usesCleartextTraffic="false" so no release build can talk
         plaintext. Development frequently must: a staging box or an emulator-hosted API
         reached as http://10.0.2.2/api via a TMS_BASE_URL dart-define. tools:replace is
         required rather than optional — the merger treats a differing value for the same
         attribute as a conflict and fails the build without it. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
