<?xml version="1.0" encoding="utf-8"?>
<!--
  API 21+ variant: the plate follows the system's window background instead of being
  hard-coded white. Dark mode is handled separately in drawable-night/, which swaps in
  the mono mark — this file only ever renders over a light plate.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />

    <item
        android:drawable="@drawable/tracgo_splash_logo"
        android:gravity="center" />
</layer-list>
