<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start window background, shown until the Flutter engine draws its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />

    <!-- Vector, not a bitmap: this is drawn at whatever the device's screen density is,
         and a raster would either blur on tablets or ship five copies. -->
    <item
        android:drawable="@drawable/tracgo_splash_logo"
        android:gravity="center" />
</layer-list>
